/**
 * Worker for review-agent.
 *
 * - `ReviewAgent` Durable Object: one instance per review (keyed by reviewId).
 *   Uses SQLite-backed storage (new_sqlite_classes migration).
 * - Static assets binding for the React+Vite SPA at apps/web/dist.
 * - Routes (handled by Worker; everything else falls through to assets):
 *     POST  /reviews                  mint reviewId + JWT
 *     GET   /reviews/:id              JSON snapshot
 *     GET   /reviews/:id/events       SSE stream
 *     POST  /reviews/:id/lifecycle    lifecycle token auth for running/failed
 *     POST  /mcp                      MCP server (streamable-HTTP, JWT-auth'd)
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "review-agent-worker",
	"main": "src/worker.ts",
	"compatibility_date": "2026-04-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,

	"durable_objects": {
		"bindings": [{ "name": "ReviewAgent", "class_name": "ReviewAgent" }]
	},

	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReviewAgent"] }],

	/**
	 * Code Mode sandbox loader. Used by `@cloudflare/codemode` to spin up an isolated
	 * Worker per `code` MCP tool call so the LLM-authored TypeScript snippet runs without
	 * sharing the host's globals or network access. The codemode wrapper dispatches
	 * `codemode.*` calls back to the host via Workers RPC, not via this loader.
	 */
	"worker_loaders": [{ "binding": "LOADER" }],

	/**
	 * SPA assets. apps/web/dist is the Vite build output (created by `pnpm --filter
	 * @review-agent/web build`). With `not_found_handling: "single-page-application"`
	 * navigation requests for /r/:id automatically serve index.html without invoking
	 * the Worker.
	 */
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},

	/**
	 * Public base URL used when minting `reviewUrl` and `mcpUrl` in POST /reviews.
	 * This is the *deployed* origin. Local `wrangler dev` overrides it to http://localhost:8787
	 * via `.dev.vars` so locally-minted review URLs still point at localhost.
	 */
	"vars": {
		"PUBLIC_BASE_URL": "https://review-agent-worker.caionogueira0626.workers.dev"
	}
}
